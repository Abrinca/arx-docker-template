## Arx settings
PROTEIN_FASTA_ENDINGS="faa"
DEFAULT_ANNOTATION_TYPE="OL"
ORTHOFINDER_ENABLED=true
CLUSTALO_ENABLED=true
IQTREE_ENABLED=true
RAXML_ENABLED=true
LOGIN_MESSAGE="Welcome to the Arx demo server!"
DISABLE_PERMISSION_CHECKS=true # Set to false if you want to work with permissions. See docs
# DEFAULT_PERMISSION=@tax:root  # controls which genomes are visible to all users (alternative to DISABLE_PERMISSION_CHECKS)
# LICENSE_PROXY=example.com:7777
# DB_BACKUP_ENABLED="true"
# DB_BACKUP_TIME="00:00"
# DB_RETENTION_DAYS=7
# DEFAULT_GENOMES_TABLE_URL="?columns=organism,identifier,taxonomy,sequencing_technology,genome_tags,organism_tags&restricted=False&contaminated=False&representative=True"
# NAV_LINKS='[{"label": "GitHub", "url": "https://github.com/"}]'  # custom navigation links (JSON array)

## BLAST settings
# BLAST_MAX_THREADS=8
# BLAST_EVALUE=1e-6
# BLAST_MAX_TARGET_SEQS=100

## system settings
LOGIN_REQUIRED="false"
DJANGO_ALLOWED_HOSTS="*"  # change this!
DJANGO_SECRET_KEY=""  # change this!
UWSGI_WORKERS=5
HUEY_WORKERS=4
LOG_LEVEL=INFO
# HARAKIRI=300  # time until uwsgi kills requests; see also uwsgi_read_timeout in nginx.conf

## Redis settings (only needed when using an external Redis instance)
# RUN_REDIS=false
# REDIS_URL=redis://localhost:6379/0
